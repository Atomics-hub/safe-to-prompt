{
  "name": "safe-to-prompt",
  "version": "0.1.0",
  "type": "module",
  "description": "Can this process block on human input? A TTY check says yes inside a coding agent, and the prompt hangs until the agent times out. Knows about agents, CI, sandboxes and terminals. Zero dependencies.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {"types": "./dist/index.d.mts", "default": "./dist/index.mjs"},
      "require": {"types": "./dist/index.d.cts", "default": "./dist/index.cjs"}
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {"node": ">=18"},
  "license": "MIT",
  "author": "Tom Ryan",
  "keywords": ["cli", "prompt", "interactive", "tty", "agent", "ai-agent", "ci", "headless", "non-interactive", "zero-dependency"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/api.test.mjs test/differential.test.mjs",
    "test:types": "tsc -p test/tsconfig.json",
    "test:pack": "node scripts/test-pack.mjs",
    "verify": "npm run build && npm test && npm run test:types && npm run test:pack",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {"typescript": "^5.6.0"},
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "repository": {"type": "git", "url": "git+https://github.com/Atomics-hub/safe-to-prompt.git"},
  "homepage": "https://github.com/Atomics-hub/safe-to-prompt#readme",
  "bugs": {"url": "https://github.com/Atomics-hub/safe-to-prompt/issues"}
}
